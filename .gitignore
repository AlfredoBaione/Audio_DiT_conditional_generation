# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- generated datasets (preprocess_stream.py output) ----
# Latents / conditions / wavs / split manifests / dataset metadata.
dataset_ready_cond/
dataset_ready*/
*_ready/
out_*/
latents/
conditions/
wav/
global_conditions/
splits/
dataset_meta.json
image_dataset_cond/

# ---- training / eval outputs ----
runs/                     # TensorBoard logs + checkpoints (paths.runs_dir)
cache/                    # normalizer / FD-DAC reference / cache_meta.json
checkpoints*/
*.pt                      # checkpoints & cached stats (config lives in .yaml)
test_outputs/
samples/
edits/

# ---- model weight caches (DAC / basic-pitch / CLAP / CLIP / VGGish / CREPE) ----
.cache/
.huggingface/
*.onnx

# ---- raw audio / large media (never commit datasets) ----
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.npy
*.npz

# ---- editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- keep configs and (locked) requirements ----
!requirements.txt
!requirements.lock.txt
!configs/*.yaml
!cond_default.yaml
